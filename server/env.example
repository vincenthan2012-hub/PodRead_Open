# Server Configuration
PORT=3000

# SMTP Email Configuration
# These are default values that will be used if not provided in the API request
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Note: The API also accepts smtpConfig in the request body,
# which will override these environment variables

