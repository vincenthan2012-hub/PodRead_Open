# AI Provider Configuration (Optional - can be set in app settings)
# Default AI Provider: gemini, deepseek, siliconflow, openrouter, ollama, custom
VITE_AI_PROVIDER=gemini
VITE_AI_API_URL=
VITE_AI_MODEL_NAME=gemini-3-pro-preview
VITE_AI_API_KEY=

# SMTP Email Configuration (Optional - can be set in app settings)
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=465
VITE_SMTP_USER=your_email@gmail.com
VITE_SMTP_PASS=your_app_password

# Email Service Configuration (Choose one method)
# Option 1: Backend API (recommended for production)
# For local development:
# VITE_EMAIL_API_URL=http://localhost:3000/api/send-email
# For production (Render):
# VITE_EMAIL_API_URL=https://podread-email-api.onrender.com/api/send-email
# (Replace 'podread-email-api' with your actual backend service name)

# Option 2: EmailJS (for frontend-only solutions)
# VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Gemini API Key (Optional - can be set in app settings)
GEMINI_API_KEY=your_gemini_api_key
